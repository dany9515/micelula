rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    function myEmail() {
      return request.auth.token.email;
    }

    // La célula de un documento (para saber si es del líder que escribe)
    function celulaDe(id) {
      return get(/databases/$(database)/documents/celulas/$(id)).data;
    }

    // 2026-10-18 (revisión de Sereno): IDs automáticos de Firestore (addDoc) y tipos de datos controlados,
    // para que nadie guarde HTML o código en campos que el panel muestra.
    function idValido(id) {
      return id.matches('[A-Za-z0-9]{20}');
    }
    function fechaOk(d, campo) {
      return !(campo in d) || d[campo] == null
        || (d[campo] is string && d[campo].matches('([0-9]{4}-[0-9]{2}-[0-9]{2})?'));
    }
    function textoOk(d, campo) {
      return !(campo in d) || d[campo] is string;
    }
    function miembroOk(d) {
      return d.nombre is string && d.celulaId is string
        && textoOk(d, 'telefono') && textoOk(d, 'obs') && fechaOk(d, 'ingreso')
        && (!('edad' in d) || d.edad == null || d.edad is int
            || (d.edad is string && d.edad.matches('[0-9]{0,3}')));
    }
    function reunionOk(d) {
      return d.celulaId is string && fechaOk(d, 'fecha')
        && (!('hora' in d) || (d.hora is string && d.hora.matches('([0-9]{2}:[0-9]{2}(:[0-9]{2})?)?')))
        && (!('ofrenda' in d) || d.ofrenda is number)
        && (!('cantAsistentes' in d) || d.cantAsistentes is int)
        && (!('asistentesIds' in d) || d.asistentesIds is list)
        && (!('asistentesNombres' in d) || d.asistentesNombres is list)
        && textoOk(d, 'lugar') && textoOk(d, 'tema') && textoOk(d, 'visitas') && textoOk(d, 'obs');
    }

    // Usuarios: cada uno lee/actualiza su propio doc; el admin lee y modifica todos.
    // Un líder no puede cambiar su propio rol.
    match /usuarios/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin();
      allow update: if isAuth() && request.auth.uid == userId
                       && request.resource.data.rol == resource.data.rol;
      allow update, delete: if isAdmin();
    }

    // Células: el admin ve todas; los líderes solo ven las suyas.
    match /celulas/{celulaId} {
      allow read: if isAuth() && (isAdmin() || resource.data.liderEmail == myEmail());
      allow create: if isAuth() && idValido(celulaId) && (isAdmin() || request.resource.data.liderEmail == myEmail());
      allow update: if isAdmin();
      allow delete: if isAuth() && (isAdmin() || resource.data.liderEmail == myEmail());
    }

    // Miembros: accesibles solo por el líder de esa célula o el admin.
    match /miembros/{miembroId} {
      function celulaLiderEmail() {
        return get(/databases/$(database)/documents/celulas/$(resource.data.celulaId)).data.liderEmail;
      }
      function nuevaCelulaLiderEmail() {
        return get(/databases/$(database)/documents/celulas/$(request.resource.data.celulaId)).data.liderEmail;
      }
      allow read, delete: if isAuth() && (isAdmin() || celulaLiderEmail() == myEmail());
      // 2026-10-18: al editar, la célula nueva también tiene que ser tuya (antes se podía pasar un miembro a otro líder)
      allow update: if isAuth() && (isAdmin() || (celulaLiderEmail() == myEmail()
                       && nuevaCelulaLiderEmail() == myEmail() && miembroOk(request.resource.data)));
      allow create: if isAuth() && idValido(miembroId) && (isAdmin()
                       || (nuevaCelulaLiderEmail() == myEmail() && miembroOk(request.resource.data)));
    }

    // Reuniones: cada líder accede a las de su célula (vía get); solo el admin puede editar; líder puede borrar las suyas.
    match /reuniones/{reunionId} {
      function reunionCelulaLiderEmail() {
        return get(/databases/$(database)/documents/celulas/$(resource.data.celulaId)).data.liderEmail;
      }
      allow read: if isAuth() && (isAdmin() || reunionCelulaLiderEmail() == myEmail());
      // 2026-10-15: solo en una célula propia (antes alcanzaba con poner tu correo: se podían cargar reuniones en células ajenas)
      allow create: if isAuth() && idValido(reunionId) && (isAdmin() || (request.resource.data.liderEmail == myEmail()
                       && celulaDe(request.resource.data.celulaId).liderEmail == myEmail()
                       && reunionOk(request.resource.data)));
      // Al corregir una reunión no se puede pasar a otra célula ni cambiar de líder
      allow update: if isAuth() && (isAdmin() || (resource.data.liderEmail == myEmail()
                       && request.resource.data.celulaId == resource.data.celulaId
                       && request.resource.data.liderEmail == resource.data.liderEmail
                       && reunionOk(request.resource.data)));
      allow delete: if isAuth() && (isAdmin() || resource.data.liderEmail == myEmail());
    }

    // Materiales: cualquier usuario autenticado puede leer; solo el admin puede escribir.
    match /materiales/{materialId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Fotos para el carrusel: todos los líderes ven las de todas las células (pedido del usuario).
    // 2026-10-15: cada uno publica solo fotos de SU célula y borra solo las suyas; nadie cambia la de otro.
    // La foto tiene que ser un archivo de MiCélula (fotoUrl de Storage) o, si se pasa a guardarlas en la
    // base como MiCatálogo, un JPEG chico (fotoData). Hoy Storage está apagado (facturación cerrada).
    match /fotos/{fotoId} {
      allow read: if isAuth();
      allow create: if isAuth() && (isAdmin() || celulaDe(request.resource.data.celulaId).liderEmail == myEmail())
                       && (!('fotoUrl' in request.resource.data)
                           || request.resource.data.fotoUrl.matches('https://firebasestorage[.]googleapis[.]com/.*'))
                       && (!('fotoData' in request.resource.data)
                           || (request.resource.data.fotoData is string && request.resource.data.fotoData.size() < 400000
                               && request.resource.data.fotoData.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')));
      allow update: if isAdmin();
      allow delete: if isAuth() && (isAdmin() || celulaDe(resource.data.celulaId).liderEmail == myEmail());
    }
  }
}
